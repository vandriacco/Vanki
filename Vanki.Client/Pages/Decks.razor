@page "/decks"
@inject IHttpClientFactory Factory
@inject DeckService DecksService
@inject IDialogService Dialog
@inject NavigationManager NavigationManager

<PageTitle>Decks</PageTitle>

<MudContainer Class="d-flex align-center justify-center mud-width-full" style="height:100vh">
    <MudPaper Class="pa-4" Style="width:100%; max-width:900px;">
        <MudGrid Class="justify-space-between align-items-center">
            <MudItem>
                <MudText Typo="Typo.h5" GutterBottom>Your Decks</MudText>
            </MudItem>

            <MudItem>
                <MudStack Row Spacing="2">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.TwoTone.Add"
                               OnClick="AddDeck">
                        Add
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Sharp.Edit"
                               OnClick="ToggleEdit">
                        Edit
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>



        @if (!string.IsNullOrEmpty(Error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@Error</MudAlert>
        }

        @if (Loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudTable Items="_decks" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    @if (Edit)
                    {
                        <MudTh></MudTh>
                    }
                    <MudTh style="width:50px">Due</MudTh>
                    <MudTh style="width:50px">New</MudTh>
                    <MudTh style="width:100px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudTd DataLabel="Name">
                            <MudLink Href="@($"/decks/{context.Id}/cards")">
                                @context.Name
                            </MudLink>
                        </MudTd>
                    </MudTd>
                    @if(Edit)
                    {
                        <MudTd>
                            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Sharp.Delete"
                                        OnClick="@(()=>DeleteDeck(context.Id))">
                                Delete
                            </MudButton>
                            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Sharp.Edit"
                                        OnClick="@(()=>EditDeck(context.Id, context.Name))">
                                Update
                            </MudButton>
                         </MudTd>
                    }
                    <MudTd DataLabel="Due">@context.CardsDue</MudTd>
                    <MudTd DataLabel="New">@context.NewCards</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Filled"
                                    Disabled="@(@context.CardsDue == 0)"
                                    Href="@($"/review/{context.Id}")">
                            Review
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private List<DeckSummaryDto>? _decks;
    private bool Loading = true;
    private string? Error;
    private bool Edit = false;

    private string Front { get; set; } = string.Empty;
    private string Back { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadDecks();

    private async Task LoadDecks()
    {
        Error = null; Loading = true;
        try 
        {
            _decks = await DecksService.GetDecks(); 
        }
        catch (Exception ex) 
        { 
            Error = ex.Message; 
        }
        finally 
        { 
            Loading = false; 
        }
    }

    private void ToggleEdit() => Edit = !Edit;

    private async Task AddDeck()
    {
        var parameters = new DialogParameters { ["DeckId"] = null, ["InitialName"] = string.Empty };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<AddDeckDialog>("Add Deck", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is AddDeckDialog.DeckInput input)
        {
            await DecksService.CreateDeck(input.Name);
            await LoadDecks();
        }
    }

    private async Task EditDeck(Guid deckId, string currentName)
    {
        var parameters = new DialogParameters { ["DeckId"] = deckId, ["InitialName"] = currentName };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<AddDeckDialog>("Edit Deck", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is AddDeckDialog.DeckInput input)
        {
            await DecksService.UpdateDeck(deckId, input.Name);
            await LoadDecks();
        }
    }

    private async Task DeleteDeck(Guid deckId)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<DeleteDialog>("Delete Deck", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await DecksService.DeleteDeck(deckId);
            await LoadDecks();
        }
    }
}